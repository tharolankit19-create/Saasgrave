# ─── Supabase ───────────────────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_publishable_key
# Server-only. NEVER expose to the browser. Rotate if ever leaked.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# ─── Dodo Payments ──────────────────────────────────────────
# https://app.dodopayments.com → Developer → API Keys
DODO_API_KEY=your_dodo_secret_key
DODO_WEBHOOK_SECRET=your_dodo_webhook_signing_secret
# test_mode | live_mode
DODO_ENV=test_mode
# Two SEPARATE products in the Dodo dashboard — one per paid action.
# Listing a startup is FREE, so it needs no product.
DODO_PRODUCT_ID_ADS=prod_xxxxxxxx            # the $49 "Ad Slot" product
DODO_PRODUCT_ID_SALE=prod_yyyyyyyy           # the $9 "Sale Listing" product

# ─── Analytics (optional) ───────────────────────────────────
# Powers the live "visitors this week" FOMO counter on the landing page.
# Plausible: Settings → API Keys (a stats-api key), and your site's domain.
# Leave blank and the counter falls back to real on-platform activity.
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=your-domain.com
# Self-hosted Plausible? point this at it. Defaults to plausible.io.
PLAUSIBLE_HOST=https://plausible.io

# ─── AI (story mode) ────────────────────────────────────────
# Preferred: OpenRouter (works with NVIDIA Nemotron and many models).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key
# Optional — any OpenRouter model id. Defaults to an NVIDIA Nemotron model.
OPENROUTER_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# Fallback provider (used only if OPENROUTER_API_KEY is unset).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# ─── App ────────────────────────────────────────────────────
# Local dev: http://localhost:3000 · Production: https://saasgrave.org
NEXT_PUBLIC_SITE_URL=https://saasgrave.org
